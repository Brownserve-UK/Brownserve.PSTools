---
name: stage-release
on:
  workflow_dispatch:
    inputs:
      release_type:
        description: 'The type of release to perform'
        required: true
        default: 'minor'
        type: choice
        options:
          - major
          - minor
          - patch
      notice:
        description: 'An optional notice to display on this release'
        required: false
        type: string

jobs:
  stage-release:
    runs-on: ubuntu-latest
    steps:
      # Step 1: Generate a short-lived token from the GitHub App
      - name: generate-app-token
        id: app-token
        uses: actions/create-github-app-token@v1
        with:
          app-id: ${{ secrets.BROWNSERVE_CI_APP_ID }}
          private-key: ${{ secrets.BROWNSERVE_CI_APP_PRIVATE_KEY }}
      # Step 2: Checkout the repo
      - name: checkout-module
        uses: actions/checkout@v3
        with:
          path: ###MODULE_NAME###
          # We need to fetch the full history so that we can determine the changelog entries from the previous release
          fetch-depth: 0
          token: ${{ steps.app-token.outputs.token }}
      # Step 3: Call the build script
      - name: run-build-script
        shell: pwsh
        env:
          GitHubPAT: ${{ steps.app-token.outputs.token }}
          ReleaseNotice: ${{ inputs.notice }}
        run: |
            $Params = @{
              BranchName = $env:GITHUB_REF
              GitHubRepoName = '###MODULE_NAME###'
              Build = 'StageRelease'
              GitHubStageReleaseToken = $env:GitHubPAT
              ReleaseType = '${{ inputs.release_type}}'
              Verbose = $true
            }
            if ($env:ReleaseNotice) {
              $Params.Add('ReleaseNotice', $env:ReleaseNotice)
            }
            ./###MODULE_NAME###/.build/build.ps1 @Params
